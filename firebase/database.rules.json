{
  "rules": {
    "leagues": {
      "$leagueId": {
        ".read": "root.child('leagues').child($leagueId).child('members').child(auth.uid).exists()",
        ".write": "false",
        "meta": {
          ".read": "root.child('leagues').child($leagueId).child('members').child(auth.uid).exists()",
          ".write": "root.child('leagues').child($leagueId).child('commissioner').val() === auth.uid",
          ".validate": "newData.hasChildren(['name', 'season', 'commissioner'])"
        },
        "members": {
          ".read": "root.child('leagues').child($leagueId).child('members').child(auth.uid).exists()",
          ".write": "false",
          "$userId": {
            ".read": "$userId === auth.uid || root.child('leagues').child($leagueId).child('commissioner').val() === auth.uid",
            ".write": "$userId === auth.uid",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])"
          }
        },
        "standings": {
          ".read": "root.child('leagues').child($leagueId).child('members').child(auth.uid).exists()",
          ".write": "false",
          ".validate": "newData.isString()"
        },
        "rounds": {
          ".read": "root.child('leagues').child($leagueId).child('members').child(auth.uid).exists()",
          ".write": "false",
          "$roundId": {
            ".read": "root.child('leagues').child($leagueId).child('members').child(auth.uid).exists()",
            ".write": "root.child('leagues').child($leagueId).child('members').child(auth.uid).exists() && !newData.child('standings').exists()",
            "scores": {
              "$userId": {
                ".write": "$userId === auth.uid"
              }
            }
          }
        }
      }
    },
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['email', 'displayName'])"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists()",
        ".write": "auth.uid === $uid",
        "$friendUid": {
          ".read": "auth.uid === $uid || auth.uid === $friendUid",
          ".write": "auth.uid === $uid || (auth.uid === $friendUid && root.child('friendRequests').child($friendUid).child($uid).exists())"
        }
      }
    },
    "friendRequests": {
      "$toUid": {
        ".read": "auth.uid === $toUid",
        "$fromUid": {
          ".read": "auth.uid === $toUid || auth.uid === $fromUid",
          ".write": "auth.uid === $fromUid || auth.uid === $toUid"
        }
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth.uid !== null",
        ".write": "!data.exists() || auth.uid === data.child('owner').val()"
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth.uid !== null",
        ".write": "auth.uid !== null && !data.exists()"
      }
    },
    "$other": {
      ".read": "false",
      ".write": "false"
    }
  }
}
